<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>11</LangVersion>
        <RootNamespace>WsjtxClient</RootNamespace>
        <Description>.NET library to communicate with WSJTX over UDP</Description>
        <Version>1.1.3</Version>
        <TargetFramework>net8.0</TargetFramework>
        <PackageDescription>.NET library to communicate with WSJTX over UDP</PackageDescription>
        <RepositoryUrl>https://github.com/jeffu231/WsjtxClient</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <AssemblyName>WsjtxClient</AssemblyName>
        <PackageId>WsjtxClient</PackageId>
        <Authors>Jeff Uchitjil</Authors>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>

</Project>
